# Strapi backend origin (no trailing slash).
# Leave empty in production: the frontend and Strapi share one origin (Nginx
# proxies /api/ and /uploads/ to 127.0.0.1:1337), so API and media URLs stay
# relative. Local development should point at the local Strapi, e.g.:
#   VITE_STRAPI_URL=http://localhost:1337
VITE_STRAPI_URL=

# Public production origin, used for canonical URLs, Open Graph tags and sitemap.xml.
VITE_SITE_ORIGIN=
